# Documentation only: neither Python nor DSH automatically loads this file.
# 仅供参考：Python 和 DSH 均不会自动加载这个文件。
# Set these in the environment that launches DSH / 在启动 DSH 的环境中设置。
DSH_SINGING_ROOT=C:/path/to/dsh-singing
DSH_HOME=C:/Users/YourName/.dsh
DSH_FFMPEG=C:/path/to/ffmpeg.exe
DSH_QQ_WORKSPACE=C:/path/to/qq-workspace
DSH_SINGING_REFERENCE=C:/path/to/authorized-reference.wav
# Optional / 可选：local TTS mode, when no static reference is configured.
# DSH_TTS_ROOT=C:/path/to/voice-local
# DSH_TTS_PYTHON=C:/path/to/voice-local/.venv-cosy/Scripts/python.exe
# DSH_TTS_SCRIPT=C:/path/to/voice-local/tts.py
# DSH_VOICE_CONFIG=C:/path/to/voice-local/minimax.json
# DSH_SINGING_PYTHON=C:/path/to/dsh-singing/.venv/Scripts/python.exe
